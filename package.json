{
  "name": "riftbound-tools",
  "version": "1.2.2",
  "description": "Riftbound trading card game data utilities for deckbuilding, search, and card lookup.",
  "keywords": [
    "riftbound",
    "trading-card-game",
    "tcg",
    "deckbuilding",
    "card-data",
    "riftbound-tools"
  ],
  "homepage": "https://github.com/jamescer/riftbound-tools#readme",
  "bugs": {
    "url": "https://github.com/jamescer/riftbound-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamescer/riftbound-tools.git"
  },
  "license": "MIT",
  "author": "James Cerniglia",
  "engines": {
    "node": ">=14.0.0"
  },
  "type": "commonjs",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "directories": {
    "test": "test"
  },
  "files": [
    "dist",
    "riot.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:cards": "ts-node ./scripts/generate-cards.ts",
    "import:cards": "ts-node ./scripts/import-csv.ts",
    "fetch:cards": "ts-node ./scripts/fetch-cards.ts",
    "fetch:riot": "ts-node ./scripts/fetch-riot-api.ts",
    "copy-assets": "ts-node ./scripts/copy-assets.ts",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.0",
    "vitest": "^0.34.0"
  }
}
